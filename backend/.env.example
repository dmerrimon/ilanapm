# Ilana PM Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# JWT Secret Key (REQUIRED for production)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-generated-secret-key-here

# Database (Optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Stripe (for future use)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# WorkOS (for SSO - future use)
# WORKOS_API_KEY=sk_...
# WORKOS_CLIENT_ID=client_...

# SendGrid (for email notifications - future use)
# SENDGRID_API_KEY=SG...

# Sentry (for error tracking - future use)
# SENTRY_DSN=https://...@sentry.io/...

# Environment
# Set to 'production' when deployed
ENVIRONMENT=development
