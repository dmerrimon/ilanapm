            taskSet.milestones.Add(new Milestone
            {
                milestone_id = "CAN-MS-001",
                name = "Site Activated",
                phase = "Site Startup",
                is_study_level = false
            });

            taskSet.essential_documents = GetCanada_EssentialDocuments();

            return taskSet;
        }

