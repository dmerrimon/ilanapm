            // Phase 2: Ethics Committee Submission (4 tasks)
            taskSet.tasks.AddRange(new List<TemplateTask>
    {
        new TemplateTask
        {
            task_id = $"{countryCode}-SS-014",
            name = $"Prepare {irbName} Submission Package",
